<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title - Cafetería Dulce Aroma</title>

    @Styles.Render("~/Content/css")
    <style>
        /* ====== ESTILO CAFETERÍA ====== */
        body {
            background-color: #F5EFE6; /* crema suave */
            font-family: 'Segoe UI', sans-serif;
        }

        .navbar-cafe {
            background-color: #6F4E37; /* café oscuro */
            padding: 10px 0;
        }

            .navbar-cafe .navbar-brand {
                color: #F8EDE3 !important;
                font-weight: bold;
                font-size: 1.4rem;
            }

            .navbar-cafe .nav-link {
                color: #F8EDE3 !important;
                font-size: 1.1rem;
                margin-left: 12px;
            }

                .navbar-cafe .nav-link:hover {
                    color: #D9C6B2 !important;
                }

        footer {
            background-color: #6F4E37;
            text-align: center;
            padding: 12px;
            color: #F8EDE3;
            margin-top: 30px;
            border-top: 3px solid #8B6B4A;
        }

        .body-content { 
            padding-top: 20px;
        }
        .body-content {

        }
    </style>

    @Scripts.Render("~/bundles/modernizr")
</head>
<body>

    <nav class="navbar navbar-expand-sm navbar-cafe">
        <div class="container">
            @Html.ActionLink("Cafetería Dulce Aroma", "Index", "Home", null,
                new { @class = "navbar-brand" })

            <button type="button" class="navbar-toggler" data-bs-toggle="collapse"
                    data-bs-target=".navbar-collapse">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-end">
                <ul class="navbar-nav">
                    <li class="nav-item">@Html.ActionLink("Inicio", "Index", "Home", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Menú", "Index", "Home", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("API", "Index", "Help", null, new { @class = "nav-link" })</li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()
        <hr />
    </div>

    <footer>
        <p>&copy; @DateTime.Now.Year - Cafetería Dulce Aroma</p>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>

