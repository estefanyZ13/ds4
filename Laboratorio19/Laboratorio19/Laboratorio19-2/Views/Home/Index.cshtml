@{
    ViewBag.Title = "Laboratorio 19-2 - Todos los Valores";
}

<div class="container">
    <h2>Consumir API - Obtener Todos los Valores</h2>
    <hr />

    <div class="panel panel-primary">
        <div class="panel-heading">
            <h3 class="panel-title">Resultado del API</h3>
        </div>
        <div class="panel-body">
            <h4>Datos obtenidos:</h4>
            <pre>@ViewBag.Resultado</pre>
        </div>
    </div>

    <div class="alert alert-info">
        <strong>URL llamado:</strong> https://localhost:44360/api/values
    </div>
</div>